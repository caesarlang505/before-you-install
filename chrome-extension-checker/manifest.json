{
  "manifest_version": 3,
  "name": "Before You Install",
  "version": "0.1.0",
  "description": "Check a Chrome Web Store extension before installing it.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "action": {
    "default_title": "Check this extension",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
